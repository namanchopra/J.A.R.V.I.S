<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by PyTorch (LLVM JIT) and the embedded V8/WebKit runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Required by the python-build-standalone interpreter, which allocates
         executable memory for compiled bytecode. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required because PyTorch wheels ship unsigned .dylibs that are loaded
         dynamically at runtime; without this, hardened runtime rejects them. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Microphone access for wake-word detection and voice commands. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Outbound network access for LLM API calls (Anthropic, OpenAI),
         Hugging Face model downloads, etc. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
